{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.21.0/.schema/devbox.schema.json",
  "packages": {
    "actionlint":     "latest",
    "bun":            "latest",
    "charm-freeze":   "latest",
    "git":            "latest",
    "go":             "latest",
    "golangci-lint":  "latest",
    "gopls":          "latest",
    "goreleaser":     "latest",
    "govulncheck":    "latest",
    "jetbrains-mono": "latest",
    "jq":             "latest",
    "just":           "latest",
    "nixfmt":         "latest",
    "protobuf":       "latest",
    "protoc-gen-go":  "latest",
    "resvg":          "latest",
    "shellcheck":     "latest"
  },
  "env": {
    "CGO_ENABLED": "0"
  },
  "shell": {
    "init_hook": [
      "if [ -f .env ]; then set -a; . ./.env; set +a; fi"
    ]
  }
}
