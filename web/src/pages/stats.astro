---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import Footer from "../components/Footer.astro";
---

<StarlightPage
  frontmatter={{
    description:
      "How often proton-cli is installed and updated, from the public counters every release channel leaves behind.",
    title: "Stats",
  }}
>
  <p class="lead">
    Every number here counts an <em>acquisition</em>: a release asset fetched, a page visited, a star
    given. None of it comes from the program. proton-cli has no telemetry, and installing it tells
    nobody anything - these are the counters GitHub, npm, Repology and the AUR publish about the
    project, recorded once a day so they have a history.
  </p>

  <div class="stats">
    <p class="pending">Loading…</p>
  </div>

  <h2>What these numbers are not</h2>
  <p>
    A download is not a person. Release assets are fetched by mirrors, scanners and continuous
    integration as well as by people, and nothing here reports whether what was downloaded was ever
    run, or run twice.
  </p>
  <p>
    Some channels leave no counter at all. <strong>Nix</strong> builds from source and serves from a
    shared binary cache, <strong>go install</strong> is answered by a global module proxy,
    and <strong>apt</strong> installs come from this project's own repository, which keeps no logs.
    Whatever those account for is missing from every figure above.
  </p>
  <p>
    Clones count automation as readily as people, because a checkout in continuous integration is a
    full clone and runs on every push. That is why the figure here is unique cloners rather than
    clones.
  </p>

  <Footer />
</StarlightPage>

<script>
  import { repo, stats as source } from "../../site.ts";

  type CountDay = { date: string; count: number };
  type DownloadDay = {
    date: string;
    hours: number;
    update: number;
    script: number;
    other: number;
    platform: Record<string, number>;
    version: Record<string, number>;
  };
  type TrafficDay = {
    date: string;
    clones: number;
    cloners: number;
    views: number;
    visitors: number;
  };
  type Source = { name: string; count: number; uniques: number };
  type Packaged = { repository: string; version: string; status: string };
  type Stats = {
    updated_at: string;
    totals: { downloads: number; stars: number; forks: number; latest: string };
    downloads: DownloadDay[];
    traffic: TrafficDay[];
    traffic_window: { clones: number; cloners: number; views: number; visitors: number };
    stars: CountDay[];
    forks: CountDay[];
    npm: CountDay[];
    npm_platforms: Record<string, number>;
    referrers: Source[];
    paths: Source[];
    packaging: Packaged[];
    aur: { votes: number; popularity: number };
  };

  const channels = [
    { key: "script", label: "Install script" },
    { key: "other", label: "Package managers and direct" },
    { key: "update", label: "Self-updates" },
  ] as const;

  const number = new Intl.NumberFormat("en");

  const el = (tag: string, className?: string, text?: string) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  const svg = (tag: string, attributes: Record<string, string | number>) => {
    const node = document.createElementNS("http://www.w3.org/2000/svg", tag);
    for (const [key, value] of Object.entries(attributes)) {
      node.setAttribute(key, String(value));
    }
    return node;
  };

  /* A recording covering more than a day is one the cron missed, and its counts
   * belong to the whole gap rather than to the date they were written under.
   *
   * A recording covering less than a day is left alone. Scaling a short interval
   * up to a full one invents demand nobody observed: a single download caught in
   * a ten-minute window is one download, not the hundred and forty-four a day of
   * them would be. */
  const perDay = (row: DownloadDay, value: number) =>
    row.hours > 24 ? (value * 24) / row.hours : value;

  const since = (days: number) => {
    const from = new Date();
    from.setUTCDate(from.getUTCDate() - days);
    return from.toISOString().slice(0, 10);
  };

  const sum = (rows: DownloadDay[], from: string) =>
    rows
      .filter((row) => row.date >= from)
      .reduce((total, row) => total + row.script + row.other + row.update, 0);

  const tally = (rows: DownloadDay[], from: string, field: "platform" | "version") => {
    const totals: Record<string, number> = {};
    for (const row of rows.filter((r) => r.date >= from)) {
      for (const [key, value] of Object.entries(row[field])) {
        if (key) totals[key] = (totals[key] ?? 0) + value;
      }
    }
    return Object.entries(totals).sort(([, a], [, b]) => b - a);
  };

  const section = (title: string, note?: string) => {
    const node = el("section", "panel");
    node.append(el("h3", undefined, title));
    if (note) node.append(el("p", "note", note));
    return node;
  };

  /* Bars rather than an area, because each day is a separate count rather than
   * a reading of something continuous, and a line between two of them would
   * draw values that were never measured.
   *
   * The axis is the whole window in days rather than however many rows happen
   * to exist, so a week of recordings draws as a week against the right-hand
   * edge instead of stretching to fill a quarter it cannot speak for. */
  const bars = (rows: DownloadDay[], span: number) => {
    const width = 720;
    const height = 180;
    const chart = svg("svg", {
      viewBox: `0 0 ${width} ${height}`,
      class: "chart",
      role: "img",
      "aria-label": "Downloads per day, by channel",
    });
    const peak = Math.max(1, ...rows.map((r) => perDay(r, r.script + r.other + r.update)));
    const slot = width / span;
    const start = Date.parse(`${since(span - 1)}T00:00:00Z`);

    for (const row of rows) {
      const offset = Math.round((Date.parse(`${row.date}T00:00:00Z`) - start) / 864e5);
      if (offset < 0 || offset >= span) continue;

      const column = svg("g", {});
      let base = height;
      for (const { key } of channels) {
        const value = perDay(row, row[key]);
        if (value <= 0) continue;
        const tall = (value / peak) * (height - 8);
        base -= tall;
        column.append(
          svg("rect", {
            x: offset * slot,
            y: base,
            width: Math.max(slot - 1, 1.5),
            height: tall,
            class: `bar bar-${key}`,
          }),
        );
      }
      const total = Math.round(perDay(row, row.script + row.other + row.update));
      const label = svg("title", {});
      label.textContent = `${row.date}: ${total} download${total === 1 ? "" : "s"}`;
      column.append(label);
      chart.append(column);
    }
    return chart;
  };

  const axis = (span: number) => {
    const node = el("div", "axis");
    node.append(el("span", undefined, since(span - 1)), el("span", undefined, "today"));
    return node;
  };

  const line = (rows: CountDay[], label: string) => {
    const width = 720;
    const height = 120;
    const chart = svg("svg", {
      viewBox: `0 0 ${width} ${height}`,
      class: "chart",
      role: "img",
      "aria-label": label,
    });
    const peak = Math.max(1, ...rows.map((r) => r.count));
    const step = width / Math.max(rows.length - 1, 1);
    const points = rows
      .map((row, index) => `${index * step},${height - (row.count / peak) * (height - 8)}`)
      .join(" ");
    chart.append(svg("polyline", { points, class: "line" }));
    return chart;
  };

  const legend = () => {
    const node = el("ul", "legend");
    for (const { key, label } of channels) {
      const item = el("li");
      item.append(el("span", `swatch swatch-${key}`), el("span", undefined, label));
      node.append(item);
    }
    return node;
  };

  const figures = (rows: DownloadDay[]) => {
    const node = el("div", "figures");
    for (const [label, days] of [
      ["Last 7 days", 7],
      ["Last 30 days", 30],
      ["Last 90 days", 90],
    ] as const) {
      const box = el("div", "figure");
      box.append(
        el("strong", undefined, number.format(sum(rows, since(days)))),
        el("span", undefined, label),
      );
      node.append(box);
    }
    return node;
  };

  const ranked = (entries: [string, number][], limit = 6) => {
    const node = el("ul", "ranked");
    const peak = Math.max(1, ...entries.map(([, value]) => value));
    for (const [key, value] of entries.slice(0, limit)) {
      const item = el("li");
      const meter = el("span", "meter");
      meter.style.setProperty("--fill", `${(value / peak) * 100}%`);
      item.append(el("span", "key", key), meter, el("span", "value", number.format(value)));
      node.append(item);
    }
    if (entries.length === 0) node.append(el("li", "empty", "Nothing recorded yet."));
    return node;
  };

  const table = (rows: string[][], headings: string[]) => {
    const node = el("table", "grid");
    const head = el("thead");
    const headRow = el("tr");
    for (const heading of headings) headRow.append(el("th", undefined, heading));
    head.append(headRow);
    const body = el("tbody");
    for (const row of rows) {
      const line = el("tr");
      for (const cell of row) line.append(el("td", undefined, cell));
      body.append(line);
    }
    node.append(head, body);
    return node;
  };

  const ago = (iso: string) => {
    const hours = Math.round((Date.now() - new Date(iso).getTime()) / 36e5);
    if (hours < 1) return "just now";
    if (hours < 24) return `${hours} hour${hours === 1 ? "" : "s"} ago`;
    const days = Math.round(hours / 24);
    return `${days} day${days === 1 ? "" : "s"} ago`;
  };

  const render = (root: HTMLElement, data: Stats) => {
    root.replaceChildren();

    const header = el("p", "updated", `Recorded ${ago(data.updated_at)}.`);
    root.append(header);

    const totals = el("div", "figures figures-lead");
    for (const [label, value] of [
      ["Downloads, all time", number.format(data.totals.downloads)],
      ["Stars", number.format(data.totals.stars)],
      ["Forks", number.format(data.totals.forks)],
      ["Newest release", data.totals.latest],
    ] as const) {
      const box = el("div", "figure");
      box.append(el("strong", undefined, value), el("span", undefined, label));
      totals.append(box);
    }
    root.append(totals);

    const span = 90;
    const recent = data.downloads.filter((row) => row.date >= since(span - 1));
    const downloads = section("Downloads per day", `Last ${span} days`);
    if (recent.length === 0) {
      downloads.append(
        el(
          "p",
          "note",
          "A rate is the difference between two recordings, so the first one appears a day after the first run.",
        ),
      );
    } else {
      downloads.append(bars(recent, span), axis(span), legend(), figures(data.downloads));
    }
    root.append(downloads);

    const breakdown = el("div", "columns");
    const platforms = section("By platform", "Last 30 days");
    platforms.append(ranked(tally(data.downloads, since(30), "platform")));
    const versions = section("Version being fetched", "Last 30 days");
    versions.append(ranked(tally(data.downloads, since(30), "version")));
    breakdown.append(platforms, versions);
    root.append(breakdown);

    if (data.stars.length > 0) {
      const growth = section("Stars", `${data.stars[0]?.date} to today`);
      growth.append(line(data.stars, "Stars over time"));
      root.append(growth);
    }

    const window = data.traffic_window;
    if (window && window.views + window.clones > 0) {
      const audience = section(
        "Repository visitors",
        "Last 14 days, as GitHub counts them: someone who came back on a later day is still one person, so these are smaller than the daily figures added together.",
      );
      audience.append(
        table(
          [
            ["Clones", number.format(window.clones), number.format(window.cloners)],
            ["Page views", number.format(window.views), number.format(window.visitors)],
          ],
          ["", "Total", "Unique people"],
        ),
      );
      root.append(audience);
    }

    const arrivals = el("div", "columns");
    const from = section("Where people arrive from", "Last 14 days");
    from.append(ranked(data.referrers.map((r) => [r.name, r.uniques] as [string, number])));
    const read = section("What they read", "Last 14 days");
    read.append(
      ranked(
        data.paths.map(
          (p) => [p.name.replace("/roman-16/proton-cli", "") || "/", p.uniques] as [string, number],
        ),
      ),
    );
    arrivals.append(from, read);
    root.append(arrivals);

    if (data.packaging.length > 0) {
      const packaged = section(
        "Packaged in",
        "Via Repology. A version behind the newest release means that distribution's users are on older code.",
      );
      packaged.append(
        table(
          data.packaging.map((p) => [p.repository, p.version, p.status]),
          ["Repository", "Version", "State"],
        ),
      );
      packaged.append(
        el(
          "p",
          "note",
          `AUR: ${data.aur.votes} vote${data.aur.votes === 1 ? "" : "s"}, popularity ${data.aur.popularity.toFixed(2)}.`,
        ),
      );
      root.append(packaged);
    }

    const npmRecent = data.npm.slice(-30).reduce((total, d) => total + d.count, 0);
    const npm = section(
      "npm",
      "Counted apart from everything above, and never added into it. npm reports registry requests rather than installs, and mirrors re-fetch packages continuously. The six platform packages are mutually exclusive - an install pulls exactly one of them - so whatever the six have in common is machinery rather than people.",
    );
    npm.append(
      el("p", "figure-inline", `${number.format(npmRecent)} requests in the last 30 days`),
      ranked(Object.entries(data.npm_platforms).sort(([, a], [, b]) => b - a)),
    );
    root.append(npm);
  };

  /* The two ways this fails are told apart, because "the recording is
   * unreachable" and "the recording is unreadable" are different problems and
   * only one of them is mine. */
  const excuse = (root: HTMLElement, reason: string) => {
    root.replaceChildren();
    const message = el("p", "note");
    const link = el("a", undefined, "The releases page") as HTMLAnchorElement;
    link.href = `${repo}/releases`;
    message.append(`${reason} `, link, " has the all-time totals.");
    root.append(message);
  };

  const show = async (root: HTMLElement) => {
    let data: Stats;
    try {
      const response = await fetch(source);
      if (!response.ok) throw new Error(String(response.status));
      data = (await response.json()) as Stats;
    } catch {
      excuse(root, "The recorded counters could not be reached.");
      return;
    }
    try {
      render(root, data);
    } catch (error) {
      console.error(error);
      excuse(root, "The recorded counters could not be charted.");
    }
  };

  const root = document.querySelector<HTMLElement>(".stats");
  if (root) void show(root);
</script>

<style>
  .lead {
    font-size: var(--sl-text-lg);
    color: var(--sl-color-gray-2);
  }

  .stats :global(.panel) {
    margin-block-start: 2.5rem;
  }

  .stats :global(h3) {
    margin-block-end: 0.25rem;
  }

  .stats :global(.note) {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    margin-block: 0.25rem 0.75rem;
  }

  .stats :global(.chart) {
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
  }

  .stats :global(.bar-script) {
    fill: var(--proton-purple);
  }

  .stats :global(.bar-other) {
    fill: color-mix(in oklab, var(--proton-purple) 55%, transparent);
  }

  .stats :global(.bar-update) {
    fill: color-mix(in oklab, var(--proton-purple) 25%, transparent);
  }

  .stats :global(.line) {
    fill: none;
    stroke: var(--proton-purple);
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .stats :global(.axis) {
    display: flex;
    justify-content: space-between;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    margin-block-start: 0.25rem;
    font-variant-numeric: tabular-nums;
  }

  .stats :global(.legend) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    padding: 0;
    margin-block: 0.75rem 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  .stats :global(.legend li) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .stats :global(.swatch) {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border-radius: 2px;
    background: var(--proton-purple);
  }

  .stats :global(.swatch-other) {
    background: color-mix(in oklab, var(--proton-purple) 55%, transparent);
  }

  .stats :global(.swatch-update) {
    background: color-mix(in oklab, var(--proton-purple) 25%, transparent);
  }

  .stats :global(.figures) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1rem;
    margin-block-start: 1.25rem;
  }

  .stats :global(.figures-lead) {
    margin-block: 1.5rem 0;
  }

  .stats :global(.figure),
  .stats :global(.legend li),
  .stats :global(.ranked li) {
    margin-block-start: 0;
  }

  .stats :global(.figure) {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .stats :global(.figure strong) {
    font-size: var(--sl-text-2xl);
    line-height: 1.1;
  }

  .stats :global(.figure span) {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .stats :global(.figure-inline) {
    font-size: var(--sl-text-xl);
    margin-block: 0.5rem;
  }

  .stats :global(.columns) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0 2.5rem;
  }

  .stats :global(.ranked) {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--sl-text-sm);
  }

  .stats :global(.ranked li) {
    display: grid;
    grid-template-columns: minmax(6rem, 1fr) 4rem 3rem;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.3rem;
  }

  .stats :global(.ranked .key) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .stats :global(.meter) {
    block-size: 0.5rem;
    border-radius: 999px;
    background: var(--sl-color-gray-6);
    overflow: hidden;
  }

  .stats :global(.meter)::after {
    content: "";
    display: block;
    block-size: 100%;
    inline-size: var(--fill);
    background: var(--proton-purple);
  }

  .stats :global(.ranked .value) {
    text-align: end;
    color: var(--sl-color-gray-3);
    font-variant-numeric: tabular-nums;
  }

  .stats :global(.grid) {
    inline-size: 100%;
    font-size: var(--sl-text-sm);
  }

  .stats :global(.updated),
  .stats :global(.pending) {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
