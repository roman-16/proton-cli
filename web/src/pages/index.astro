---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import Apps from "../components/Apps.astro";
import Footer from "../components/Footer.astro";
import Install from "../components/Install.astro";
import { description, origin, repo } from "../../site.ts";

const demoAlt =
  "Listing unread mail, uploading a file to Drive, previewing which files a cleanup would remove, and listing Pass items";

const traits = [
  {
    body: "SRP login and the full PGP key hierarchy, handled on your machine with Proton's own go-srp and gopenpgp. No bridge, no proxy, no browser in the middle.",
    title: "Real end-to-end encryption",
  },
  {
    body: "Mail, Drive, Calendar, Pass and Contacts, in a single static executable on Linux, macOS and Windows. One grammar and one output shape across all five.",
    title: "Five apps, one binary",
  },
  {
    body: "JSON and YAML with one envelope shape for every list, streaming stdin and stdout, exit codes that mean something, and --dry-run on everything that changes state.",
    title: "Built for pipes and cron",
  },
];

const questions = [
  { href: "/about/faq/#is-proton-cli-made-by-proton", text: "Is this made by Proton?" },
  {
    href: "/about/faq/#how-does-it-compare-to-protons-own-tools",
    text: "How does it compare to Proton's own CLIs?",
  },
  {
    href: "/about/faq/#how-is-it-different-from-proton-mail-bridge",
    text: "How is it different from Bridge?",
  },
  { href: "/about/faq/#is-it-safe-to-give-it-my-proton-password", text: "Is my password safe?" },
  { href: "/about/faq/#do-i-need-a-paid-proton-plan", text: "Do I need a paid plan?" },
  { href: "/about/faq/#does-it-work-on-a-headless-server", text: "Does it work on a server?" },
  { href: "/about/faq/#can-an-ai-agent-use-it", text: "Can an AI agent use it?" },
];

const application = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "Command Line Interface",
  author: { "@type": "Person", name: "roman-16", url: repo.replace("/proton-cli", "") },
  codeRepository: repo,
  description,
  downloadUrl: `${repo}/releases/latest`,
  license: "https://opensource.org/licenses/MIT",
  name: "proton-cli",
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  operatingSystem: "Linux, macOS, Windows",
  url: origin,
};
---

<StarlightPage
  frontmatter={{
    description,
    hero: {
      actions: [
        { link: "/install/", text: "Install", variant: "primary" },
        { link: "/first-commands/", text: "First commands", variant: "secondary" },
        { link: repo, text: "GitHub", variant: "minimal" },
      ],
      tagline: description,
      title: "proton-cli",
    },
    template: "splash",
    title: "Your CLI for Proton",
  }}
  hasSidebar={false}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(application)} />

  <Install />

  <section class="demo">
    <img alt={demoAlt} class="only-dark" src="/demo-dark.svg" />
    <img alt={demoAlt} class="only-light" src="/demo-light.svg" />
  </section>

  <section class="traits">
    {
      traits.map(({ body, title }) => (
        <div class="trait">
          <h2>{title}</h2>
          <p>{body}</p>
        </div>
      ))
    }
  </section>

  <section class="what">
    <h2>What you can do</h2>
    <p class="lead">
      Every command reads the same way, <code>proton &lt;app&gt; &lt;collection&gt; &lt;verb&gt;</code
      >, and anywhere one wants an ID, a subject, name or URL works too.
    </p>
    <Apps />
  </section>

  <section class="what">
    <h2>Common questions</h2>
    <p class="lead">
      Proton ships a CLI for Drive and one for Pass, and Bridge for mail in a desktop client. This is
      one binary across all five apps.
    </p>
    <ul class="questions">
      {questions.map(({ href, text }) => (
        <li>
          <a href={href}>{text}</a>
        </li>
      ))}
    </ul>
  </section>

  <Footer />
</StarlightPage>

<style>
  .demo {
    margin-block: 4rem;
  }

  .demo img {
    inline-size: 100%;
    block-size: auto;
  }

  :global([data-theme="light"]) .only-dark,
  :global([data-theme="dark"]) .only-light {
    display: none;
  }

  /*
   * The three reasons to use this rather than a browser. They were set smaller
   * than the prose around them, which put the argument in the quietest type on
   * the page.
   */
  .traits {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    margin-block: 5rem;
  }

  /*
   * The gap is the grid's to set. Markdown flow gives every element after the
   * first a top margin, which here would drop all but one column.
   */
  .trait,
  .questions li {
    margin: 0;
  }

  .trait h2 {
    border: 0;
    font-size: var(--sl-text-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 0.625rem;
    padding: 0;
  }

  .trait h2::before {
    background: var(--sl-color-text-accent);
    block-size: 1.25rem;
    content: "";
    display: block;
    inline-size: 2px;
    margin-block-end: 0.875rem;
  }

  .trait p {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-base);
    line-height: 1.6;
    margin: 0;
  }

  .what {
    margin-block-start: 5rem;
  }

  .what h2 {
    border: 0;
    font-size: var(--sl-text-3xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
    padding: 0;
  }

  .lead {
    color: var(--sl-color-gray-3);
    margin-block: 0.75rem 2rem;
  }

  .questions {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .questions a {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--foreground);
    display: block;
    font-size: var(--sl-text-sm);
    padding: 0.875rem 1rem;
    text-decoration: none;
  }

  .questions a:hover {
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-text-accent);
  }
</style>
